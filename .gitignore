# `pip install -e .` writes this, and the README's own setup step is an
# editable install - so the documented way to set the project up left an
# untracked directory in `git status` for everyone who followed it.
*.egg-info/
*.pdf
.DS_Store

# Generated evaluation datasets: ~300MB, regenerable byte-identically from
# (frozen generator commit, seed). EVAL_SET_MANIFEST.json records a content
# hash per seed, which is a checkable claim rather than 2,880 unread files.
data/eval/
